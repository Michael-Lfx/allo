{
  "name": "allo-app-server-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:packages && vite",
    "build": "bun run build:packages && vite build",
    "preview": "vite preview",
    "typecheck": "bun run build:packages && tsc --noEmit",
    "test": "bun run build:packages && vitest run",
    "mock": "bun scripts/mock-server.ts",
    "build:packages": "bun --filter './packages/*' build"
  },
  "dependencies": {
    "@agent-store/client": "workspace:*",
    "@agent-store/protocol": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "ahooks": "^3.9.7",
    "es-toolkit": "^1.52.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15",
    "@agent-store/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
