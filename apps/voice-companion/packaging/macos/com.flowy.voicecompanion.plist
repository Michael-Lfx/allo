<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flowy.voicecompanion</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/voice-companion</string>
        <string>--config</string>
        <string>/etc/voice-companion/config.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/Flowy/voice-companion</string>
    <key>StandardOutPath</key>
    <string>/var/log/flowy-voice-companion.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/flowy-voice-companion.error.log</string>
</dict>
</plist>
