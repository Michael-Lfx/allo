{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomi.dev/schemas/montage/artifacts/edit_decisions.json",
  "title": "Edit Decisions",
  "description": "The final shot order and timing handed to video_compose — the direct input to Rule Zero's delivery_promise / slideshow_risk gates.",
  "type": "object",
  "additionalProperties": true,
  "required": ["render_runtime", "shots", "out_name"],
  "properties": {
    "render_runtime": { "type": "string", "enum": ["ffmpeg", "remotion", "hyperframes"] },
    "out_name": { "type": "string", "minLength": 1 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "is_motion": { "type": "boolean" },
          "hold_secs": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
