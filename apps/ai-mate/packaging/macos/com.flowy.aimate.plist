<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flowy.aimate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ai-mate</string>
        <string>--config</string>
        <string>/etc/ai-mate/config.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/Flowy/ai-mate</string>
    <key>StandardOutPath</key>
    <string>/var/log/flowy-ai-mate.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/flowy-ai-mate.error.log</string>
</dict>
</plist>
