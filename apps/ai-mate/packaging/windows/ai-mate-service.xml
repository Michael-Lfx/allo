<service>
  <id>FlowyAiMate</id>
  <name>Flowy AI Mate Voice Companion Service</name>
  <description>Flowy AI Mate headless voice companion daemon</description>
  <executable>%BASE%\ai-mate.exe</executable>
  <arguments>--config "%ProgramData%\Flowy\ai-mate\config.toml"</arguments>
  <logmode>rotate</logmode>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
</service>
