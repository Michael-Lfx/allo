{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-store/index-market.schema.json",
  "title": "Agent Store index market (schema_version 2)",
  "description": "Doc 30 §6.1: an index-first market ships one `index.json` (+ optional `categories.json`). Each entry names an absolute `download` URL plus the archive's sha256/size; entry payloads are fetched on demand instead of mirroring a tree.",
  "type": "object",
  "required": ["schema_version", "market", "entries"],
  "properties": {
    "schema_version": { "const": 2 },
    "market": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "market_kind": { "enum": ["plugin", "skill", "connector"] },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "minLength": 10 },
    "categories_url": { "type": "string", "pattern": "^(https?)://\\S+$" },
    "categories_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://\\S+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "files": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entry": {
      "title": "Index market entry",
      "type": "object",
      "required": ["name", "download", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "display": { "type": "object" },
        "description": { "type": "object" },
        "version": { "type": "string" },
        "kind": { "enum": ["agent", "team", "plugin", "skill", "connector"] },
        "download": { "type": "string", "pattern": "^https://\\S+$" },
        "member": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "files": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string" },
        "category_id": { "type": "string" },
        "category_zh": { "type": "string" },
        "category_en": { "type": "string" },
        "tags_zh": { "type": "array", "items": { "type": "string" } },
        "tags_en": { "type": "array", "items": { "type": "string" } },
        "examples_zh": { "type": "array", "items": { "type": "string" } },
        "examples_en": { "type": "array", "items": { "type": "string" } },
        "default_init_prompt": { "type": "object" },
        "quick_prompts": { "type": "array", "items": { "type": "object" } },
        "icon_url": { "type": "string", "pattern": "^https://\\S+$" },
        "available": { "type": "boolean" },
        "unavailable_reason": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
