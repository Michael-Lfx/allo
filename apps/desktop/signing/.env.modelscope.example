# Copy to `.env.modelscope` (gitignored) before `bun run upload:modelscope`.
#
# Used by scripts/upload-modelscope-release.py when these keys are not already
# set in the environment.
#
# OTA publishes to the international ModelScope hub. China (modelscope.cn) and
# international (modelscope.ai) have separate accounts and tokens.
MODELSCOPE_ENDPOINT=https://www.modelscope.ai
#
# Generate a token on the SAME site:
#   https://www.modelscope.ai/my/myaccesstoken
#
# Keep it short-lived and revoke when no longer needed.
MODELSCOPE_TOKEN=ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
