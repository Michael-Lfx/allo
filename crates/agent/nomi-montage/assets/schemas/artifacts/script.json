{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomi.dev/schemas/montage/artifacts/script.json",
  "title": "Script",
  "description": "Scene-broken narration/dialogue script — the textual spine the scene_plan visualizes.",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "narration": { "type": "string" },
          "dialogue": { "type": "string" }
        }
      }
    }
  }
}
