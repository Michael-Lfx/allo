{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomi.dev/schemas/montage/artifacts/brief.json",
  "title": "Brief",
  "description": "The founding creative brief for a project: what we're making and for whom.",
  "type": "object",
  "additionalProperties": true,
  "required": ["topic", "key_message"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "target_audience": { "type": "string" },
    "key_message": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "desired_duration_secs": { "type": "number", "minimum": 0 },
    "notes": { "type": "string" }
  }
}
