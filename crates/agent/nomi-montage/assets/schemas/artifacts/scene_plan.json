{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomi.dev/schemas/montage/artifacts/scene_plan.json",
  "title": "Scene Plan",
  "description": "Shot-level breakdown of every scene — what the camera sees, in what order, and whether each shot is motion or a held still.",
  "type": "object",
  "additionalProperties": true,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "shots"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["idx", "description"],
              "properties": {
                "idx": { "type": "integer", "minimum": 0 },
                "description": { "type": "string", "minLength": 1 },
                "duration_secs": { "type": "number", "minimum": 0 },
                "is_motion": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
